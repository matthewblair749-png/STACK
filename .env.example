# STACK environment variables.
# Copy to .env.local for development. In production set these in Vercel > Project > Settings >
# Environment Variables. Never commit real values. Full reference (what each does and what
# happens when it's missing): docs/LAUNCH.md

# ============================================================================
# REQUIRED - the app won't start or sign anyone in without these
# ============================================================================

# Postgres connection string (Neon pooled URL in production). Use a SEPARATE database for
# development - never point local work at the production database.
DATABASE_URL=

# Auth.js session signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# Encrypts every stored app token/key at rest (AES-256-GCM). 32 bytes, base64.
# Generate: openssl rand -base64 32. Changing it makes existing connections unreadable.
ENCRYPTION_KEY=

# Public URL of this deployment, no trailing slash (e.g. https://www.stackunder.website).
# Used for OAuth redirect URLs, Stripe return URLs, metadata and the sitemap.
APP_URL=http://localhost:3000

# Contact address shown in the footer, Help and the legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# ============================================================================
# SIGN-IN - at least one provider, or nobody can sign in
# ============================================================================

# Google (console.cloud.google.com > APIs & Services > Credentials). The same client also powers
# the Google integration (Gmail, Calendar, Drive).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (entra.microsoft.com > App registrations). Also powers the Microsoft 365
# integration. Leave TENANT as "common" for any work/school or personal account.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Sign in with Apple (needs a paid Apple Developer membership and a live HTTPS domain).
# APPLE_PRIVATE_KEY is the .p8 file contents; newlines may be written as \n.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email sign-in links via Resend. In production this stays OFF while EMAIL_FROM is a
# @resend.dev address - set it to an address on your verified domain, e.g.
# "STACK <login@stackunder.website>".
RESEND_API_KEY=
EMAIL_FROM=

# ============================================================================
# AI - optional. Without any key, STACK AI answers from synced data only and says so.
# ============================================================================

ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5-5 when unset.
ANTHROPIC_MODEL=
# How hard Claude thinks in chat: low, medium (default), high, xhigh or max. Higher is slower and costs more.
ANTHROPIC_EFFORT=
# Fallback model when Claude is unavailable: any OpenAI-compatible API (e.g. Groq).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Full AI answers per person per rolling 24 hours (default 50).
AI_DAILY_LIMIT=

# ============================================================================
# ERROR MONITORING - optional. Without it, errors only go to the Vercel logs.
# ============================================================================

# Sentry project DSN (sentry.io > Project > Settings > Client Keys). Errors only, no PII.
NEXT_PUBLIC_SENTRY_DSN=

# ============================================================================
# APP CONNECTIONS (OAuth) - optional per app. Without a pair, that app shows
# "Not available yet" - or, if it supports it, the user can paste their own token.
# Redirect URL to register for each: <APP_URL>/api/integrations/<app>/callback
# ============================================================================

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# Box client IDs are 32 lowercase letters/digits; anything else is rejected as misconfigured.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# "true" to talk to the QuickBooks sandbox instead of real companies.
QUICKBOOKS_SANDBOX=
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Trello uses an API key (trello.com/power-ups/admin), not a client pair.
TRELLO_API_KEY=
# Stripe Connect, for users linking THEIR OWN Stripe account to STACK (not STACK's billing).
STRIPE_CONNECT_CLIENT_ID=
# Development only: send one app's OAuth redirect through a public tunnel, e.g.
# OAUTH_REDIRECT_BASE_SLACK=https://your-tunnel.example (Slack rejects http://localhost).
# OAUTH_REDIRECT_BASE_<APP>=

# ============================================================================
# BILLING (Stripe) - optional. Without STRIPE_SECRET_KEY the app runs as free early access.
# ============================================================================

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# ============================================================================
# CALLS - optional. Works without setup (public STUN). Add a TURN relay only if some
# people's calls fail to connect behind strict corporate networks.
# ============================================================================

TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
